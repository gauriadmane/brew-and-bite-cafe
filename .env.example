# Copy to .env and add your own secrets. NEVER commit .env to Git.
NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string for your brew_and_bite database.
# Generate in Atlas > Database > Connect > Drivers. URL-encode reserved characters in credentials.
MONGODB_URI=

# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 0 = no tax configured; basis points (100 = 1%, 1000 = 10%).
TAX_BPS=0

# Use ONLY Razorpay TEST keys (rzp_test_...). Leave empty for cash-only development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the webhook secret configured in Razorpay Test Dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Optional email. Render Free blocks outbound SMTP ports 25, 465 and 587.
# Customers can request their OTP securely in My Orders without email.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The first owner is created with TEMPORARY terminal environment variables:
# OWNER_EMAIL, OWNER_PASSWORD (12+ characters), OWNER_NAME.
# Do not store owner credentials in this file or in Git.
